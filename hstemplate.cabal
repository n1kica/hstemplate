cabal-version: 3.14
name: hstemplate
version: 0.1.0.0
synopsis: Minimal Haskell Raylib project template
description: A minimal Haskell Raylib project template.
category: Development
license: MIT
license-file: LICENSE
author: nikica
maintainer: kooh.kooh2@gmail.com
extra-doc-files: README.md CHANGELOG.md

executable hstemplate
    ghc-options: 
      -Wall
      -Wno-name-shadowing
      -Wno-type-defaults
      -threaded
      -rtsopts
    main-is: Main.hs
    build-depends:
      base ^>=4.21.0.0,
      raylib-hs
    hs-source-dirs: app
    default-language: GHC2024
    default-extensions: 
      DuplicateRecordFields,
      NoFieldSelectors,
      OverloadedRecordDot,
      OverloadedStrings,
      LambdaCase,
      MultiWayIf,
      DerivingVia,
      NamedFieldPuns,
      TypeApplications,

source-repository head
    type: git
    location: https://github.com/n1kica/hstemplate
